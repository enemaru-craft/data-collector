                    "texts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "variables": {
                      "type": "object",
                      "properties": {
                        "totalPower": {
                          "type": "number",
                          "description": "float32"
                        },
                        "surplusPower": {
                          "type": "number",
                          "description": "float32"
                        }
                      },
                      "required": [
                        "totalPower",
                        "surplusPower"
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "texts",
                    "variables"
                  ]
                },
                "example": {
