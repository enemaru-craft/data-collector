                    "isLightEnabled": false,
                    "isTrainEnabled": false,
                    "isFactoryEnabled": true,
                    "isBlackout": false
                  },
                  "texts": [],
                  "variables": {
                    "totalPower": 88,
                    "surplusPower": 81
                  }
