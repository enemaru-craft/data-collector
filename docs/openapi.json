    "/get-latest-power": {
      "get": {
        "summary": "/get-latest-power",
        "deprecated": false,
        "description": "session_idとdevice_typeを指定した最新の発電量を種t区する",
        "tags": [],
        "parameters": [
          {
            "name": "device_type",
            "in": "query",
            "description": "geothermal,solar,wind,hydrogenのいずれか",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "description": "デバイス登録時に指定したsession_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "gpsLat": {
                      "type": "string",
                      "description": "緯度"
                    },
                    "gpsLon": {
                      "type": "string",
                      "description": "経度"
                    },
                    "latestPower": {
                      "type": "string",
                      "description": "float32型の発電量(kW)"
                    }
                  },
                  "required": [
                    "gpsLat",
                    "gpsLon",
                    "latestPower"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/register-new-power-generation-module": {
      "post": {
        "summary": "/register-new-power-generation-module",
        "deprecated": false,
        "description": "これを一番最初に実行する｡",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "description": "ルームIDみたいな感じ｡これに世界とデバイスを紐づける｡重複は許可されている｡(同じルームに複数デバイス入るため)"
                  },
                  "deviceId": {
                    "type": "string",
                    "description": "これの重複は許可されていない｡UUIDなどの被らないものを指定するとよい｡"
                  },
                  "deviceType": {
                    "type": "string",
                    "description": "geothermal,solar,hydrogen,windのいずれかを指定する"
                  }
                },
                "required": [
                  "sessionId",
                  "deviceId",
                  "deviceType"
                ]
              },
              "examples": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Registration successful": {
                      "type": "string",
                      "description": "JSONの形にするの忘れてた済まない｡メッセージと200返ってくる｡"
                    }
                  },
                  "required": [
                    "Registration successful"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/get-current-world-state": {
