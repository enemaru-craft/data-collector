                    "state": {
                      "type": "object",
                      "properties": {
                        "isLightEnabled": {
                          "type": "boolean"
                        },
                        "isTrainEnabled": {
                          "type": "boolean"
                        },
                        "isFactoryEnabled": {
                          "type": "boolean"
                        },
                        "isBlackout": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "isLightEnabled",
                        "isTrainEnabled",
                        "isFactoryEnabled",
                        "isBlackout"
                      ]
                    },
                    "texts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "variables": {
                      "type": "object",
                      "properties": {
                        "totalPower": {
                          "type": "number"
                        },
                        "surplusPower": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "totalPower",
                        "surplusPower"
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "texts",
                    "variables"
                  ]
                },
                "example": {
                  "state": {
                    "isLightEnabled": true,
