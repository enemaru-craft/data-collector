    "/turn-on-equipment": {
      "post": {
        "summary": "/turn-on-equipment",
        "deprecated": false,
        "description": "設備をONにする｡消費電力が供給電力を上回った場合すべてのONになっていた機器はOFFになり､isBlackoutのみONになる｡そして次にONにする場合は再計算が走るので普通にONにしてもらっても大丈夫｡",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string"
                  },
                  "equipment": {
                    "type": "string",
                    "description": "factory,train,lightから選ぶ"
                  }
                },
                "required": [
                  "sessionId",
                  "equipment"
                ]
              },
              "examples": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "object",
                      "properties": {
                        "isLightEnabled": {
                          "type": "boolean"
                        },
                        "isTrainEnabled": {
                          "type": "boolean"
                        },
                        "isFactoryEnabled": {
